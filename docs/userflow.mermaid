graph TD
    %% Onboarding Phase
    START([User Opens FlashArb App]) --> INSTALL{First Time User?}
    INSTALL -->|Yes| DOWNLOAD[Download Worldcoin Mini App]
    INSTALL -->|No| LOGIN[Login with World ID]
    DOWNLOAD --> WORLDID[Complete World ID Verification<br/>Iris/Face Scan]
    
    %% Identity Verification
    WORLDID --> VERIFY{Verification<br/>Successful?}
    VERIFY -->|No| RETRY[Retry Verification<br/>or Contact Support]
    RETRY --> WORLDID
    VERIFY -->|Yes| ONBOARD[Complete Onboarding<br/>Accept Terms & Conditions]
    LOGIN --> DASHBOARD

    %% Main Dashboard
    ONBOARD --> DASHBOARD[FlashArb Dashboard<br/>View Opportunities & Stats]
    
    %% Opportunity Discovery
    DASHBOARD --> SCAN[Scan for Arbitrage<br/>Opportunities]
    SCAN --> CHECK_RATE{Rate Limit Check<br/>1 per hour per user}
    CHECK_RATE -->|Rate Limited| WAIT[Wait for Rate Limit Reset<br/>Show Countdown Timer]
    WAIT --> DASHBOARD
    CHECK_RATE -->|Available| DISCOVER[1inch API Price Discovery<br/>Cross-Chain Analysis]
    
    %% Opportunity Evaluation
    DISCOVER --> FOUND{Profitable<br/>Opportunity?}
    FOUND -->|No| NOTIFY_NONE[No Opportunities Available<br/>Check Back Later]
    NOTIFY_NONE --> DASHBOARD
    FOUND -->|Yes| DISPLAY[Display Opportunity Details<br/>Profit Estimate, Gas Costs, Chains]
    
    %% Decision Making
    DISPLAY --> DECIDE{User Decision}
    DECIDE -->|Cancel| DASHBOARD
    DECIDE -->|Execute| CONFIRM[Confirm Transaction Details<br/>Review Risks & Fees]
    
    %% Transaction Execution
    CONFIRM --> EXECUTE[Execute Flash Loan Arbitrage<br/>via Uniswap v4 Hooks]
    EXECUTE --> ATOMIC[Atomic Cross-Chain Swap<br/>All or Nothing Execution]
    
    %% Transaction Results
    ATOMIC --> SUCCESS{Transaction<br/>Successful?}
    SUCCESS -->|Yes| PROFIT[Profit Distributed to User<br/>Update Balance & Stats]
    SUCCESS -->|No| ROLLBACK[Automatic Rollback<br/>No Loss to User]
    
    %% Post-Transaction
    PROFIT --> UPDATE_STATS[Update User Stats<br/>Leaderboard & XP]
    ROLLBACK --> LOG_FAILURE[Log Failed Attempt<br/>Analyze Failure Reason]
    UPDATE_STATS --> CELEBRATE[Show Success Animation<br/>Profit Summary]
    LOG_FAILURE --> EXPLAIN[Explain Failure Reason<br/>Market Conditions/Competition]
    
    %% Return to Dashboard
    CELEBRATE --> COOLDOWN[Rate Limit Cooldown<br/>1 Hour Timer Active]
    EXPLAIN --> DASHBOARD
    COOLDOWN --> DASHBOARD

    %% Additional Features
    DASHBOARD --> PORTFOLIO[View Portfolio<br/>Trading History & Analytics]
    DASHBOARD --> LEADERBOARD[Check Leaderboard<br/>Community Rankings]
    DASHBOARD --> SETTINGS[Settings & Preferences<br/>Notification Settings]
    
    PORTFOLIO --> DASHBOARD
    LEADERBOARD --> DASHBOARD
    SETTINGS --> DASHBOARD

    %% Liquidity Provider Journey (Branch)
    DASHBOARD --> LP_MODE{Switch to LP Mode?}
    LP_MODE -->|Yes| LP_DEPOSIT[Deposit Liquidity<br/>Earn Yield on Flash Loans]
    LP_MODE -->|No| DASHBOARD
    LP_DEPOSIT --> LP_DASHBOARD[LP Dashboard<br/>Monitor Yield & Utilization]
    LP_DASHBOARD --> DASHBOARD

    %% Emergency/Support
    DASHBOARD --> SUPPORT[Contact Support<br/>Technical Issues]
    SUPPORT --> DASHBOARD

    %% Styling for different phases
    classDef onboarding fill:#e3f2fd
    classDef verification fill:#fff8e1
    classDef opportunity fill:#e8f5e8
    classDef execution fill:#fce4ec
    classDef result fill:#f3e5f5
    classDef feature fill:#f9fbe7

    class START,INSTALL,DOWNLOAD,WORLDID onboarding
    class VERIFY,RETRY,ONBOARD,LOGIN verification
    class SCAN,CHECK_RATE,DISCOVER,FOUND,DISPLAY opportunity
    class DECIDE,CONFIRM,EXECUTE,ATOMIC execution
    class SUCCESS,PROFIT,ROLLBACK,UPDATE_STATS,CELEBRATE result
    class PORTFOLIO,LEADERBOARD,SETTINGS,LP_MODE feature